#pragma code_page(65001)

// o GLFW usa o ícone com este nome na janela e na barra de tarefas
GLFW_ICON ICON "res/img/icon.ico"

1 VERSIONINFO
    FILEVERSION 1,0,0,0
    PRODUCTVERSION 1,0,0,0
    FILEOS 0x4L
    FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName", "Francimar Alves"
            VALUE "FileDescription", "Modelagem e execução de rede Perceptron de Múltiplas Camadas"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "NeuralNetwork"
            VALUE "OriginalFilename", "NeuralNetwork.exe"
            VALUE "ProductName", "Redes Neurais"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
